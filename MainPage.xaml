<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MiniHelpDesk.App.MainPage"
             BackgroundColor="White"
             Title="Mini HelpDesk">

    <Grid Padding="12" RowDefinitions="Auto,*" RowSpacing="8">
        <HorizontalStackLayout x:Name="MobileNavigation" Grid.Row="0"
                           IsVisible="False" Spacing="8">
            <Button Text="Formularz" Clicked="OnShowFormClicked" />
            <Button Text="Lista zgłoszeń" Clicked="OnShowListClicked" />
        </HorizontalStackLayout>

        <Grid x:Name="LayoutRoot" Grid.Row="1" ColumnDefinitions="320,*"
          RowDefinitions="*" ColumnSpacing="18">
            <ScrollView x:Name="FormPanel" Grid.Column="0">
                <VerticalStackLayout Spacing="7" Padding="4,0,4,12">
                    <Label Text="Mini HelpDesk" FontSize="24" FontAttributes="Bold"
                 TextColor="Black" />

                    <Label Text="Nazwa zgłoszenia" TextColor="Black" />
                    <Entry Text="{Binding TitleInput, Mode=TwoWay}"
                 Placeholder="Np. Awaria drukarki" />
                    <Label Text="{Binding TitleError}" TextColor="Red" FontSize="12" />

                    <Label Text="Opis problemu" TextColor="Black" />
                    <Editor Text="{Binding DescriptionInput, Mode=TwoWay}"
                  Placeholder="Opisz problem" HeightRequest="85"
                  AutoSize="Disabled" />
                    <Label Text="{Binding DescriptionError}" TextColor="Red" FontSize="12" />

                    <Label Text="Priorytet" TextColor="Black" />
                    <Picker Title="Wybierz priorytet"
                  ItemsSource="{Binding Priorities}"
                  SelectedItem="{Binding SelectedPriority, Mode=TwoWay}" />
                    <Label Text="{Binding PriorityError}" TextColor="Red" FontSize="12" />

                    <Button Text="{Binding SaveButtonText}" Clicked="OnSaveClicked" />
                    <Button Text="Anuluj edycję" Clicked="OnCancelClicked" />

                    <Label Text="{Binding TotalCount, StringFormat='Wszystkie: {0}'}"
                 TextColor="Black" Margin="0,8,0,0" />
                    <Label Text="{Binding ActiveCount, StringFormat='Niezakończone: {0}'}"
                 TextColor="Black" />


                    <Button Text="Uruchom testy MSTest" Clicked="OnRunTestsClicked"
                  Margin="0,14,0,0" />
                </VerticalStackLayout>
            </ScrollView>

            <Grid x:Name="TicketsPanel" Grid.Column="1"
            RowDefinitions="Auto,*" RowSpacing="10">
                <Label Text="Zgłoszenia" FontSize="22" FontAttributes="Bold"
               TextColor="Black" />
                <CollectionView Grid.Row="1" ItemsSource="{Binding Tickets}"
                        EmptyView="Brak zgłoszeń">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Stroke="Gray" StrokeThickness="1"
                      Padding="8" Margin="0,0,0,8">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="{Binding Title}" FontAttributes="Bold"
                         TextColor="Black" />
                                    <Label Text="{Binding Description}" TextColor="Black"
                         LineBreakMode="WordWrap" />
                                    <HorizontalStackLayout Spacing="8">
                                        <Label Text="{Binding Priority}" TextColor="Black" />
                                        <Label Text="|" TextColor="Gray" />
                                        <Label Text="{Binding Status}" TextColor="Black" />
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Spacing="6">
                                        <Button Text="Edytuj" Clicked="OnEditClicked"
                            FontSize="12" Padding="8,6" />
                                        <Button Text="Usuń" Clicked="OnDeleteClicked"
                            FontSize="12" Padding="8,6" />
                                        <Button Text="Status" Clicked="OnStatusClicked"
                            FontSize="12" Padding="8,6" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
